{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role and status information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "employeeId": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "isBreakActive": { "type": "boolean" },
        "activeBreakLogId": { "type": "string" },
        "lastLocation": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "timestamp": { "type": "number" }
          }
        }
      },
      "required": ["uid", "email", "role"]
    },
    "Shift": {
      "title": "Shift Roster",
      "description": "Assigned shift for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["userId", "startTime", "endTime", "date"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "A request for time off.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "startDate", "endDate", "status"]
    },
    "BreakLog": {
      "title": "Break Activity Log",
      "description": "Log of break activities with GPS path.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "duration": { "type": "number" },
        "path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "timestamp": { "type": "number" }
            }
          }
        }
      },
      "required": ["userId", "startTime"]
    },
    "TroubleshootingGuide": {
      "title": "AI Troubleshooting Guide",
      "description": "History of troubleshooting guides provided by AI.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "problem": { "type": "string" },
        "level": { "type": "string", "enum": ["L1", "L2", "L3"] },
        "handlingTeam": { "type": "string" },
        "guide": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "problem", "level", "guide"]
    },
    "GlobalSettings": {
      "title": "Global Application Settings",
      "description": "Configurable settings for the team.",
      "type": "object",
      "properties": {
        "maxBreakDurationMinutes": { "type": "number" },
        "defaultHourlyRate": { "type": "number" },
        "defaultTimezone": { "type": "string" }
      }
    },
    "ShiftTemplate": {
      "title": "Shift Template",
      "description": "Preset shift times and types.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["name", "startTime", "endTime"]
    },
    "AuditLog": {
      "title": "Administrative Audit Log",
      "description": "Record of admin actions.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "timestamp": { "type": "number" },
        "details": { "type": "string" }
      },
      "required": ["adminId", "action", "timestamp"]
    },
    "Announcement": {
      "title": "System Announcement",
      "description": "Global broadcast messages.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "number" },
        "priority": { "type": "string", "enum": ["low", "high", "urgent"] }
      },
      "required": ["content", "createdAt", "priority"]
    },
    "ShiftSwapRequest": {
      "title": "Shift Swap Request",
      "description": "A request to trade or give away a shift.",
      "type": "object",
      "properties": {
        "requesterId": { "type": "string" },
        "requesterName": { "type": "string" },
        "shiftId": { "type": "string" },
        "shiftDate": { "type": "string" },
        "shiftTime": { "type": "string" },
        "targetUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "approved", "rejected", "cancelled"] },
        "createdAt": { "type": "number" }
      },
      "required": ["requesterId", "shiftId", "status", "createdAt"]
    },
    "WellnessCheck": {
      "title": "Personnel Wellness Check",
      "description": "Daily status check for team members.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["optimal", "stable", "stressed", "critical"] },
        "score": { "type": "number" },
        "notes": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "status", "score", "timestamp"]
    },
    "Message": {
      "title": "Team Communication Message",
      "description": "A message in the internal chat system.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["text", "userId", "userName", "timestamp"]
    },
    "PerformanceMetric": {
      "title": "Personnel Performance Metric",
      "description": "Aggregated performance data.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "efficiency": { "type": "number" },
        "attendance": { "type": "number" },
        "compliance": { "type": "number" },
        "month": { "type": "string" }
      },
      "required": ["userId", "month"]
    },
    "Mission": {
      "title": "Tactical Mission Assignment",
      "description": "High-priority task for field personnel.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "failed", "aborted"] },
        "priority": { "type": "string", "enum": ["low", "high", "critical"] },
        "assignedTo": { "type": "array" },
        "deadline": { "type": "number" },
        "createdAt": { "type": "number" },
        "type": { "type": "string", "enum": ["recon", "security", "logistics", "emergency"] }
      },
      "required": ["title", "status", "priority", "deadline", "createdAt"]
    },
    "GlobalSystemState": {
      "title": "Global System State",
      "description": "Cross-application state for emergency protocols.",
      "type": "object",
      "properties": {
        "lockdownActive": { "type": "boolean" },
        "alertLevel": { "type": "string", "enum": ["normal", "elevated", "critical"] },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      }
    },
    "IncidentTicket": {
      "title": "Incident & Escalation Ticket",
      "description": "Structured L1-L3 incident ticket for shift handovers and escalation.",
      "type": "object",
      "properties": {
        "ticketNumber": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tier": { "type": "string", "enum": ["L1", "L2", "L3"] },
        "team": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "investigating", "mitigated", "resolved"] },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "assignedToId": { "type": "string" },
        "assignedToName": { "type": "string" },
        "stepsTaken": { "type": "array" },
        "failedSteps": { "type": "array" },
        "successfulStep": { "type": "string" },
        "resolutionNotes": { "type": "string" },
        "shiftType": { "type": "string" },
        "hasScreenshot": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "resolvedAt": { "type": "number" }
      },
      "required": ["ticketNumber", "title", "tier", "status", "creatorId", "createdAt"]
    },
    "ShiftHandoverReport": {
      "title": "Shift Handover Report",
      "description": "Formal shift handover log with active incident counts and checklist.",
      "type": "object",
      "properties": {
        "outgoingShift": { "type": "string" },
        "incomingShift": { "type": "string" },
        "leadEngineerId": { "type": "string" },
        "leadEngineerName": { "type": "string" },
        "notes": { "type": "string" },
        "openIncidentsCount": { "type": "number" },
        "criticalAlerts": { "type": "array" },
        "verifiedChecklist": { "type": "object" },
        "signOffTimestamp": { "type": "number" }
      },
      "required": ["outgoingShift", "incomingShift", "leadEngineerId", "signOffTimestamp"]
    }
  },
  "firestore": {
    "system/state": {
      "schema": "GlobalSystemState",
      "description": "Singleton for app state."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Shift roster data."
    },
    "leaveRequests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Leave requests collection."
    },
    "breakLogs/{logId}": {
      "schema": "BreakLog",
      "description": "History of breaks."
    },
    "troubleshootingGuides/{guideId}": {
      "schema": "TroubleshootingGuide",
      "description": "Logs of AI troubleshooting."
    },
    "settings/{settingId}": {
      "schema": "GlobalSettings",
      "description": "Global application configuration."
    },
    "auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin action history."
    },
    "announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Team-wide broadcasts."
    },
    "shiftTemplates/{templateId}": {
      "schema": "ShiftTemplate",
      "description": "Reusable shift patterns."
    },
    "shiftSwaps/{swapId}": {
      "schema": "ShiftSwapRequest",
      "description": "Marketplace for shift trades."
    },
    "wellness/{checkId}": {
      "schema": "WellnessCheck",
      "description": "Employee status checks."
    },
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Internal communication log."
    },
    "missions/{missionId}": {
      "schema": "Mission",
      "description": "Tactical task assignments."
    },
    "performanceMetrics/{metricId}": {
      "schema": "PerformanceMetric",
      "description": "Analytics for users."
    },
    "incidentTickets/{ticketId}": {
      "schema": "IncidentTicket",
      "description": "Active and resolved shift incident tickets."
    },
    "shiftHandovers/{handoverId}": {
      "schema": "ShiftHandoverReport",
      "description": "Shift handover reports and checklists."
    }
  }
}
